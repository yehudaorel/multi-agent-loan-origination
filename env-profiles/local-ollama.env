# Profile: laptop dev with a local Ollama-served model.
# Copy to .env: cp env-profiles/local-ollama.env .env

# -- Company display --
# COMPANY_NAME=Acme FinTech Company
# AGENT_NAME=

# -- Database (Postgres container) --
POSTGRES_DB=mortgage-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai
COMPLIANCE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai

# -- API --
DEBUG=false
ALLOWED_HOSTS=["http://localhost:3000"]

# -- Auth (disabled for dev) --
AUTH_DISABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mortgage-ai

# -- LLM: local Ollama --
# Start Ollama on the host: `ollama serve` (default port 11434).
# Pull a tool-capable model first, e.g. `ollama pull qwen2.5:7b-instruct`.
#
# Linux container networking note: the API container cannot reach the
# host's localhost by default. Either:
#   (a) Podman: `podman-compose --network=host up -d`, OR set
#       LLM_BASE_URL=http://host.containers.internal:11434/v1
#   (b) Docker: add `extra_hosts: ["host.docker.internal:host-gateway"]`
#       to mortgage-ai-api in compose.yml, then use:
#       LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5:7b-instruct

# -- Vision (optional; same endpoint, different model when set) --
# VISION_BASE_URL=
# VISION_MODEL=
# VISION_API_KEY=

# -- MCP servers (Compose network names; correct as-is for Compose) --
MCP_RISK_SERVER_URL=http://mcp-risk-server:8081/mcp
MCP_COMPLIANCE_URL=http://mcp-compliance:8082/mcp
MCP_PIPELINE_URL=http://mcp-pipeline:8083/mcp
MCP_DECISION_URL=http://mcp-decision:8084/mcp
MCP_ANALYTICS_URL=http://mcp-analytics:8085/mcp
PREDICTIVE_MODEL_MCP_URL=

# -- Observability (off by default for local dev) --
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=mortgage-ai

# -- UI --
VITE_API_BASE_URL=http://localhost:8000
VITE_ENVIRONMENT=development
