# Profile: testing on a low-spec home box using MiniMax M2.7 hosted API.
# Copy to .env: cp env-profiles/minimax.env .env
# Then edit .env to fill in LLM_API_KEY (search for FILL_IN).

# -- Company display --
# COMPANY_NAME=Acme FinTech Company
# AGENT_NAME=

# -- Database (Postgres container) --
POSTGRES_DB=mortgage-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai
COMPLIANCE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai

# -- API --
DEBUG=false
ALLOWED_HOSTS=["http://localhost:3000"]

# -- Auth (disabled for dev) --
AUTH_DISABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mortgage-ai

# -- LLM: MiniMax (hosted, OpenAI-compatible) --
# Get an API key at https://platform.minimax.io/ (or .minimaxi.com mirror).
# Model id format: MiniMax-M2, MiniMax-M2.5, MiniMax-M2.7 (newest).
# Tool/function calling supported. 204K context window.
# Region alternative: https://api.minimaxi.com/v1
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=FILL_IN_YOUR_MINIMAX_API_KEY
LLM_MODEL=MiniMax-M2.7

# -- Vision (optional; same provider supports multimodal models) --
# VISION_BASE_URL=https://api.minimax.io/v1
# VISION_MODEL=
# VISION_API_KEY=FILL_IN_YOUR_MINIMAX_API_KEY

# -- MCP servers (Compose network names; correct as-is for Compose) --
MCP_RISK_SERVER_URL=http://mcp-risk-server:8081/mcp
MCP_COMPLIANCE_URL=http://mcp-compliance:8082/mcp
MCP_PIPELINE_URL=http://mcp-pipeline:8083/mcp
MCP_DECISION_URL=http://mcp-decision:8084/mcp
MCP_ANALYTICS_URL=http://mcp-analytics:8085/mcp
PREDICTIVE_MODEL_MCP_URL=

# -- Observability (off by default for local dev) --
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=mortgage-ai

# -- UI --
VITE_API_BASE_URL=http://localhost:8000
VITE_ENVIRONMENT=development
