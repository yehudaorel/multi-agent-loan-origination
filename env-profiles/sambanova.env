# Profile: SambaNova Cloud (production "token farm gen" target).
# Copy to .env: cp env-profiles/sambanova.env .env
# Then edit .env to fill in LLM_API_KEY (search for FILL_IN).

# -- Company display --
# COMPANY_NAME=Acme FinTech Company
# AGENT_NAME=

# -- Database (Postgres container) --
POSTGRES_DB=mortgage-ai
POSTGRES_USER=user
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai
COMPLIANCE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/mortgage-ai

# -- API --
DEBUG=false
ALLOWED_HOSTS=["http://localhost:3000"]

# -- Auth (disabled for dev; flip to false for the booth-side run) --
AUTH_DISABLED=true
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mortgage-ai

# -- LLM: SambaNova Cloud (OpenAI-compatible) --
# Get an API key at https://cloud.sambanova.ai/apis
# Models (selection): Meta-Llama-3.3-70B-Instruct, Meta-Llama-3.1-405B-Instruct,
# Meta-Llama-3.1-8B-Instruct, DeepSeek-V3.1, Llama-4-Maverick-17B-128E-Instruct,
# Qwen2.5-72B-Instruct.
# Default below targets a tool-capable, free-tier-eligible balanced choice.
# Booth/production runs may want the 405B for the strongest tool-using
# behavior; rate-limit considerations apply (10 RPM at 405B vs ~30 RPM at 8B).
LLM_BASE_URL=https://api.sambanova.ai/v1
LLM_API_KEY=FILL_IN_YOUR_SAMBANOVA_API_KEY
LLM_MODEL=Meta-Llama-3.3-70B-Instruct

# -- Vision (optional; SambaNova supports vision-capable models) --
# VISION_BASE_URL=https://api.sambanova.ai/v1
# VISION_MODEL=Llama-4-Maverick-17B-128E-Instruct
# VISION_API_KEY=FILL_IN_YOUR_SAMBANOVA_API_KEY

# -- MCP servers (Compose network names; correct as-is for Compose) --
MCP_RISK_SERVER_URL=http://mcp-risk-server:8081/mcp
MCP_COMPLIANCE_URL=http://mcp-compliance:8082/mcp
MCP_PIPELINE_URL=http://mcp-pipeline:8083/mcp
MCP_DECISION_URL=http://mcp-decision:8084/mcp
MCP_ANALYTICS_URL=http://mcp-analytics:8085/mcp
PREDICTIVE_MODEL_MCP_URL=

# -- Observability (off by default; flip on for booth runs) --
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=mortgage-ai

# -- UI --
VITE_API_BASE_URL=http://localhost:8000
VITE_ENVIRONMENT=production
